{
  "extends": "../../tsconfig.base.json",
  "include": ["src/main.ts", "src/chess-ai.ts", "src/env.d.ts", "src/App.vue"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
